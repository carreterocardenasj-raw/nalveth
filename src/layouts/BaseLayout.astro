---
import '../styles/global.css';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { INMOBI_UNIVERSAL_TAG } from '../lib/inmobi-universal-tag';

export interface Props extends SeoProps {
  bodyClass?: string;
}

const { bodyClass, ...seoProps } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Adelanta la conexión a Google Fonts (usadas vía @import en global.css, sin
         cambiar ni autoalojar las fuentes) para que el navegador no espere a parsear
         el CSS para empezar esa conexión — mejora de rendimiento de bajo riesgo, sin
         tocar qué fuentes se cargan. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <Seo {...seoProps} />
    {/*
      InMobi Choice — Universal Tag (CMP ID 10), instalado el 16/09/2026 en TODAS las
      páginas (BaseLayout.astro es el único layout raíz del sitio). Debe ser el PRIMER
      script de terceros del <head> — cualquier script futuro de AdSense/analítica/Tag
      Manager se añade DESPUÉS de esta línea, nunca antes. El contenido exacto (no editado
      a mano) vive en src/lib/inmobi-universal-tag.ts. Este tag ya expone sus propios
      stubs __tcfapi/__gpp/__uspapi — src/lib/consent.ts solo los CONSULTA (API estándar),
      no crea una segunda implementación ni los sobrescribe.
    */}
    <Fragment set:html={INMOBI_UNIVERSAL_TAG} />
    {/* Medición (Fase 3A): inerte hasta que src/data/analytics.ts tenga IDs. Siempre DESPUÉS
         del tag de InMobi. GA4 solo se carga tras consentimiento (ver lib/analytics-snippet.ts). */}
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Fase 3C-1: aviso automático de "Enlace de afiliado" para cualquier enlace marcado con
  // data-track-affiliate="true" — el mismo atributo que ya usa el tracking de GA4 (Fase 3A/3B),
  // una sola fuente de verdad, sin sistema paralelo. Hoy todos los enlaces comerciales llevan
  // data-track-affiliate="false", así que esto no cambia nada visible todavía. El día que un
  // enlace concreto pase a "true" (herramientas.md, software.md), el aviso aparece solo, sin
  // tocar código. Se excluye el CTA de las reviews (.cta-card): ese ya muestra su propio aviso
  // en un párrafo dedicado (ver ReviewLayout.astro) — esto evita duplicarlo.
  document.querySelectorAll('a[data-track-affiliate="true"]').forEach((a) => {
    if (a.closest('.cta-card')) return;
    if (a.nextElementSibling?.classList.contains('tag')) return;
    const tag = document.createElement('span');
    tag.className = 'tag';
    tag.textContent = 'Enlace de afiliado';
    tag.style.marginLeft = '.4em';
    a.insertAdjacentElement('afterend', tag);
  });
</script>

<style is:global>
  .skip-link {
    position: absolute; left: -9999px; top: 0; z-index: 100;
    background: var(--ink); color: var(--bg); padding: .7em 1.2em; border-radius: 0 0 8px 0;
  }
  .skip-link:focus { left: 0; }
</style>

---
import { getVisibleCategories } from '../lib/content';
import { TERRITORIES } from '../data/territories';
const categories = await getVisibleCategories();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div class="col-brand">
      <p class="brand">NALVETH</p>
      <p class="tagline">IA, herramientas y estrategias para hacer crecer tu negocio.</p>
    </div>

    <div class="col">
      <p class="col-heading">Explorar</p>
      <ul>
        {categories.map((c) => <li><a href={`/${c.slug}/`}>{c.short}</a></li>)}
        {TERRITORIES.map((t) => <li><a href={t.href}>{t.short}</a></li>)}
      </ul>
    </div>

    <div class="col">
      <p class="col-heading">NALVETH</p>
      <ul>
        <li><a href="/sobre-nalveth/">Sobre NALVETH</a></li>
        <li><a href="/politica-editorial/">Política editorial</a></li>
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="col-heading">Legal</p>
      <ul>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        {/* Contenedor reservado para InMobi Choice (CMP ID 10): la propiedad está
             configurada con "Display privacy consent as a link at the footer" y
             Link Element ID = "nalveth-privacy". Debe ser un contenedor vacío, sin
             href/onclick/lógica propia — es InMobi quien inserta y gestiona el
             enlace ahí dentro (ver ../.claude/docs/legal.md). No añadir contenido
             ni comportamiento manual a este div. Comentario de plantilla: no se
             publica en el HTML. */}
        <li><div id="nalveth-privacy"></div></li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>&copy; {year} NALVETH. Algunos enlaces de este sitio son de afiliado: si compras a través de ellos, podemos recibir una comisión sin coste adicional para ti. Ver <a href="/politica-editorial/">política editorial</a>.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--surface); margin-top: var(--sp-8); }
  .grid {
    display: grid; gap: var(--sp-5);
    grid-template-columns: 1.6fr repeat(3, 1fr);
    padding-block: var(--sp-7);
  }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; margin: 0 0 .4em; }
  .tagline { color: var(--ink-soft); max-width: 32ch; margin: 0; }
  /* Etiquetas de columna del footer: antes eran <h4>, pero al venir siempre después
     del contenido principal de cada página (que normalmente termina en H2/H3) creaban
     un salto de nivel en la jerarquía de encabezados (H2 → H4) en las 31 páginas del
     sitio — el footer es navegación auxiliar, no parte del contenido, así que no
     necesita ser un encabezado real. Cambiadas a <p class="col-heading"> con el mismo
     aspecto visual exacto que tenían como h4 (mismo tipo, tamaño, mayúsculas, color). */
  .col-heading {
    font-family: var(--font-body); font-weight: 700; line-height: 1.15; text-wrap: balance;
    font-size: var(--step-0); text-transform: uppercase; letter-spacing: .04em;
    color: var(--ink-soft); margin: 0 0 var(--sp-2);
  }
  .col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .5em; }
  .col a { color: var(--ink-soft); text-decoration: none; font-size: var(--step--1); }
  .col a:hover { color: var(--accent-strong); }

  /* #nalveth-privacy queda vacío hasta que InMobi Choice inyecta su propio enlace ahí
     dentro — estas reglas solo evitan que el hueco rompa el layout mientras tanto y
     hacen que el enlace que InMobi inserte se vea igual que sus vecinos de la columna
     Legal. :global() es necesario porque ese <a> lo añade JS de terceros, no Astro. */
  #nalveth-privacy { min-height: 1em; }
  #nalveth-privacy :global(a) { color: var(--ink-soft); text-decoration: none; font-size: var(--step--1); }
  #nalveth-privacy :global(a:hover) { color: var(--accent-strong); }
  .bottom { padding-block: var(--sp-4); border-top: 1px solid var(--line); }
  .bottom p { color: var(--ink-faint); font-size: .82rem; margin: 0; max-width: 80ch; }

  @media (max-width: 780px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
</style>

---
// Enlazado bidireccional fijo entre las 5 páginas del mini-cluster VERI*FACTU.
// Deliberadamente hardcodeado (no generado desde la colección): el cluster está
// acotado a estas 5 URLs por decisión editorial — ver docs/VERIFACTU-CLUSTER.md.
export interface Props { current: string }
const { current } = Astro.props;

const PAGES = [
  { href: '/verifactu/', label: 'VERI*FACTU 2027: qué es y a quién afecta', short: 'El pilar' },
  { href: '/verifactu-autonomos/', label: 'VERI*FACTU para autónomos', short: 'Para autónomos' },
  { href: '/software-verifactu/', label: 'Mejores programas compatibles con VERI*FACTU', short: 'Comparativa de software' },
  { href: '/verifactu-gratis/', label: 'VERI*FACTU gratis: app de Hacienda y alternativas', short: 'Opciones gratis' },
  { href: '/verifactu-vs-factura-electronica/', label: 'VERI*FACTU vs. factura electrónica', short: 'Diferencias normativas' },
] as const;

const others = PAGES.filter((p) => p.href !== current);
---
<nav class="cluster-nav" aria-label="Resto del clúster VERI*FACTU">
  <h2>Sigue explorando este clúster</h2>
  <ul>
    {others.map((p) => (
      <li><a href={p.href}><span class="short">{p.short}</span><span class="full">{p.label}</span></a></li>
    ))}
  </ul>
</nav>

<style>
  .cluster-nav {
    max-width: var(--page-width); margin: 0 auto; padding: var(--sp-6) 0 var(--sp-8);
    border-top: 1px solid var(--line);
  }
  .cluster-nav h2 { font-size: var(--step-1); margin-bottom: var(--sp-3); color: var(--ink-soft); }
  .cluster-nav ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--sp-3);
  }
  .cluster-nav a {
    display: block; padding: var(--sp-3); border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; color: var(--ink);
  }
  .cluster-nav a:hover { border-color: var(--accent); }
  .cluster-nav .short { display: block; font-weight: 700; color: var(--accent-strong); font-size: var(--step--1); text-transform: uppercase; letter-spacing: .02em; margin-bottom: .3em; }
  .cluster-nav .full { display: block; font-size: var(--step--1); color: var(--ink-soft); }
</style>

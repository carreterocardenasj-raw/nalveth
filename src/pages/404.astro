---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página que buscas no existe o se ha movido." noindex>
  <div class="container notfound">
    <span class="eyebrow">Error 404</span>
    <h1>No encontramos esta página</h1>
    <p>Puede que el enlace esté roto o que la página se haya movido. Prueba a volver al inicio o explorar las herramientas.</p>
    <div class="cta-row">
      <a class="btn btn--primary" href="/">Ir al inicio</a>
      <a class="btn btn--ghost" href="/herramientas/">Explorar herramientas</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound { padding-block: var(--sp-8); text-align: center; max-width: 50ch; margin-inline: auto; }
  .cta-row { display: flex; gap: var(--sp-3); justify-content: center; margin-top: var(--sp-4); flex-wrap: wrap; }
</style>

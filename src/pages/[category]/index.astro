---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedContent } from '../../lib/content';
import { CATEGORIES, getCategory } from '../../data/categories';

export async function getStaticPaths() {
  const all = await getPublishedContent();
  const populated = new Set(all.map((e) => e.data.category));
  return CATEGORIES.filter((c) => populated.has(c.slug)).map((c) => ({
    params: { category: c.slug },
    props: { entries: all.filter((e) => e.data.category === c.slug) },
  }));
}

const { category: slug } = Astro.params;
const { entries } = Astro.props as { entries: Awaited<ReturnType<typeof getPublishedContent>> };
const category = getCategory(slug!)!;
---
<BaseLayout title={category.name} description={category.description}>
  <div class="container">
    <Breadcrumbs items={[{ name: category.short }]} />
  </div>

  <header class="container cat-head">
    <h1>{category.name}</h1>
    <p class="lede">{category.description}</p>
    {category.subAreas && (
      <ul class="subareas">
        {category.subAreas.map((s) => <li>{s.name}</li>)}
      </ul>
    )}
  </header>

  <section class="container grid">
    {entries.map((entry) => <ArticleCard entry={entry} />)}
  </section>
</BaseLayout>

<style>
  .cat-head { padding-block: var(--sp-4) var(--sp-5); max-width: var(--content-width); }
  .lede { color: var(--ink-soft); font-size: var(--step-1); }
  .subareas { list-style: none; display: flex; flex-wrap: wrap; gap: .5em; padding: 0; margin: var(--sp-3) 0 0; }
  .subareas li {
    font-size: .78rem; font-weight: 600; color: var(--accent-strong); background: var(--accent-soft);
    padding: .3em .8em; border-radius: 99px;
  }
  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--sp-4);
    padding-bottom: var(--sp-8);
  }
</style>

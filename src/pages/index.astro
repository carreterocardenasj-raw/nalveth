---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedContent, getVisibleCategories } from '../lib/content';
import { TERRITORIES } from '../data/territories';

const all = await getPublishedContent();
const categories = await getVisibleCategories();

const reviews = all.filter((e) => e.kind === 'review').slice(0, 3);
const guides = all.filter((e) => e.kind === 'guide').slice(0, 3);
const comparisons = all.filter((e) => e.kind === 'comparison').slice(0, 3);
---
<BaseLayout title="NALVETH" description="IA, automatización, software y estrategias para hacer crecer tu negocio — probadas de primera mano, no recopiladas.">
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Herramientas e IA para negocios</span>
      <h1>Descubre herramientas e ideas para hacer crecer tu negocio.</h1>
      <p class="sub">IA, automatización, software y estrategias explicadas de forma clara.</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/herramientas/">Explorar herramientas</a>
        <a class="btn btn--ghost" href="#territorios">Ver los grandes temas</a>
      </div>
    </div>
  </section>

  <section class="container block" id="territorios">
    <div class="block-head"><h2>Grandes temas de NALVETH</h2></div>
    <div class="cat-grid">
      {TERRITORIES.map((t) => (
        <a class="card cat-card" href={t.href}>
          <h3>{t.name}</h3>
          <p>{t.description}</p>
        </a>
      ))}
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="container block">
      <div class="block-head"><h2>Herramientas destacadas</h2><a class="see-all" href="/ia-para-negocios/">Ver todas →</a></div>
      <div class="grid">{reviews.map((e) => <ArticleCard entry={e} showCategory />)}</div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="container block">
      <div class="block-head"><h2>Guías</h2></div>
      <div class="grid">{guides.map((e) => <ArticleCard entry={e} showCategory />)}</div>
    </section>
  )}

  {comparisons.length > 0 && (
    <section class="container block">
      <div class="block-head"><h2>Comparativas</h2></div>
      <div class="grid">{comparisons.map((e) => <ArticleCard entry={e} showCategory />)}</div>
    </section>
  )}

  {categories.length > 0 && (
    <section class="container block">
      <h2>Explora por área</h2>
      <div class="cat-grid">
        {categories.map((c) => (
          <a class="card cat-card" href={`/${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="closing">
    <div class="container">
      <p>No necesitas usar más herramientas.<br /><strong>Necesitas usar las correctas.</strong></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .hero-inner { padding-block: var(--sp-7) var(--sp-6); max-width: 62ch; }
  .hero h1 { margin-top: var(--sp-2); }
  .sub { font-size: var(--step-1); color: var(--ink-soft); max-width: 46ch; }
  .cta-row { display: flex; gap: var(--sp-3); margin-top: var(--sp-4); flex-wrap: wrap; }

  .block { padding-block: var(--sp-7); border-bottom: 1px solid var(--line); }
  .block-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: var(--sp-4); }
  .see-all { font-size: var(--step--1); font-weight: 600; text-decoration: none; color: var(--accent-strong); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--sp-4); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--sp-4); margin-top: var(--sp-4); }
  .cat-card { text-decoration: none; color: inherit; }
  .cat-card:hover { border-color: var(--accent); }
  .cat-card h3 { font-size: var(--step-1); margin-bottom: .3em; }
  .cat-card p { color: var(--ink-soft); font-size: var(--step--1); margin: 0; }

  .closing { padding-block: var(--sp-8); text-align: center; background: var(--surface-alt); }
  .closing p { font-family: var(--font-display); font-size: var(--step-2); margin: 0; color: var(--ink-soft); }
  .closing strong { color: var(--ink); font-weight: 700; }
</style>

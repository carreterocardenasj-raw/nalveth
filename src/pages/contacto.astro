---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { TITULAR, TITULAR_COMPLETO } from '../data/legal';
---
<BaseLayout title="Contacto" description="Cómo ponerte en contacto con el equipo de NALVETH.">
  <div class="container"><Breadcrumbs items={[{ name: 'Contacto' }]} /></div>
  <article class="container prose page">
    <h1>Contacto</h1>
    <p>¿Tienes una corrección, una sugerencia de herramienta a probar, o una propuesta de colaboración? Escríbenos por correo.</p>

    <h2>Correo</h2>
    <p><a href={`mailto:${TITULAR.email}`}>{TITULAR.email}</a></p>

    {!TITULAR_COMPLETO && (
      <>
        <h2>Dirección postal</h2>
        <p class="pending">{TITULAR.domicilio} — se publicará aquí solo si la normativa aplicable a la actividad lo exige, una vez confirmados los datos del titular.</p>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .page { padding-block: var(--sp-5) var(--sp-8); }
  .pending { color: var(--ink-faint); font-style: italic; }
</style>
